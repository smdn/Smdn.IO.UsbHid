<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);LIBUSBDOTNET_V3</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- disable test with .NET Framework on GitHub Actions Windows runner image -->
    <TargetFrameworks Condition="
      $([MSBuild]::IsOsPlatform('Windows')) and '$(GITHUB_ACTIONS)' != 'true'
    ">net481;net462;$(TargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\Smdn.IO.UsbHid.Providers.Common\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\Smdn.IO.UsbHid.Providers.LibUsbDotNetCommon\Smdn.IO.UsbHid.DependencyInjection\*.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\Smdn.IO.UsbHid.Providers.LibUsbDotNetCommon\RuntimeDependencies.targets" />
</Project>
