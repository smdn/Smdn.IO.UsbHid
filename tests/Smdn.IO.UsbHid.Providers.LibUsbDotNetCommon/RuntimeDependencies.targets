<Project>
  <PropertyGroup>
    <_LibUsbVersion>1.0.29</_LibUsbVersion>
    <_LibUsbBaseDirectory>$(MSBuildThisFileDirectory)libusb\</_LibUsbBaseDirectory>
    <_LibUsbExtractDirectory>$(_LibUsbBaseDirectory)libusb-$(_LibUsbVersion)\</_LibUsbExtractDirectory>
    <_LibUsbDllFileFullPath>$(_LibUsbBaseDirectory)libusb-1.0.dll</_LibUsbDllFileFullPath>
  </PropertyGroup>

  <Target
    Name="InstallCIRuntimeDependencies"
    BeforeTargets="DispatchToInnerBuilds;BeforeBuild"
    Condition="'$(GITHUB_ACTIONS)' == 'true' and ('$(IsCrossTargetingBuild)' == 'true' or '$(TargetFrameworks)' == '')"
  >
    <Exec
      Command="sudo apt-get update &amp;&amp; sudo apt-get install -y libusb-1.0-0-dev"
      Condition="
        $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform(
          $([System.Runtime.InteropServices.OSPlatform]::Linux)
        ))
      "
    />

    <Exec
      Command="brew install libusb"
      Condition="
        $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform(
          $([System.Runtime.InteropServices.OSPlatform]::OSX)
        ))
      "
    />

    <Exec
      Command="vcpkg install libusb:x64-windows"
      Condition="
        $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform(
          $([System.Runtime.InteropServices.OSPlatform]::Windows)
        ))
      "
    />
  </Target>

  <Target
    Name="IncludeLibUsbDllInOutputWindows"
    BeforeTargets="CopyFilesToOutputDirectory"
    DependsOnTargets="InstallCIRuntimeDependencies"
    Condition="
      '$(GITHUB_ACTIONS)' == 'true' and
      $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform(
        $([System.Runtime.InteropServices.OSPlatform]::Windows)
      ))
    "
  >
    <PropertyGroup>
      <_LibUsbDllPath_Candidate1>$(VCPKG_INSTALLATION_ROOT)\installed\x64-windows\bin\libusb-1.0.dll</_LibUsbDllPath_Candidate1>
      <_LibUsbDllPath_Candidate2>C:\vcpkg\installed\x64-windows\bin\libusb-1.0.dll</_LibUsbDllPath_Candidate2>
      <_LibUsbDllPath_Candidate3>$(MSBuildThisFileDirectory)vcpkg_installed\x64-windows\bin\libusb-1.0.dll</_LibUsbDllPath_Candidate3>
    </PropertyGroup>

    <PropertyGroup>
      <LibUsbDllPath Condition="'$(LibUsbDllPath)' == '' and Exists('$(_LibUsbDllPath_Candidate1)')">$(_LibUsbDllPath_Candidate1)</LibUsbDllPath>
      <LibUsbDllPath Condition="'$(LibUsbDllPath)' == '' and Exists('$(_LibUsbDllPath_Candidate2)')">$(_LibUsbDllPath_Candidate2)</LibUsbDllPath>
      <LibUsbDllPath Condition="'$(LibUsbDllPath)' == '' and Exists('$(_LibUsbDllPath_Candidate3)')">$(_LibUsbDllPath_Candidate3)</LibUsbDllPath>
    </PropertyGroup>

    <Message Text="Found libusb-1.0.dll at '$(LibUsbDllPath)'" Importance="high" Condition="'$(LibUsbDllPath)' != ''" />
    <Message Text="libusb-1.0.dll could not be found in supplied path or any of standard vcpkg paths." Importance="high" Condition="'$(LibUsbDllPath)' == ''" />

    <Copy SourceFiles="$(LibUsbDllPath)" DestinationFolder="$(OutputPath)" Condition="Exists('$(LibUsbDllPath)')" />
  </Target>

  <Target
    Name="IncludeLibUsbDylibInOutputMacOs"
    BeforeTargets="GetCopyToOutputDirectoryItems"
    DependsOnTargets="InstallCIRuntimeDependencies"
    Condition="
      '$(GITHUB_ACTIONS)' == 'true' and
      $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform(
        $([System.Runtime.InteropServices.OSPlatform]::OSX)
      ))
    "
  >
    <PropertyGroup>
      <LibUsbDylibPath>/opt/homebrew/lib/libusb-1.0.dylib</LibUsbDylibPath>
      <LibUsbDylibPath Condition="!Exists('$(LibUsbDylibPath)')">/usr/local/lib/libusb-1.0.dylib</LibUsbDylibPath>
    </PropertyGroup>

    <Exec Command="ln -sf $(LibUsbDylibPath) $(OutputPath)libusb-1.0.dylib" />
  </Target>

</Project>
