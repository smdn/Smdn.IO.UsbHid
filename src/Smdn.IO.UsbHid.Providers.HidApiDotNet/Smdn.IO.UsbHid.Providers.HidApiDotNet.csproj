For full license texts, see [ThirdPartyNotices.md]($(RepositoryUrl)/tree/$(SmdnWorkflowsDotNetExpectedReleaseTag)/src/$(PackageId)/ThirdPartyNotices.md).
]]></PackageReadmeFileContent>
    </PropertyGroup>
  </Target>
</Project>
